# Скопируй в .env и заполни

# Секретный ключ для JWT — смени на что-то случайное в продакшене!
JWT_SECRET=замени-на-случайную-строку-минимум-32-символа

# Путь к SQLite базе данных (Railway: укажи путь к volume)
# DB_PATH=/data/relax.db

# Node environment
NODE_ENV=production

# Порт (Railway подставляет автоматически)
# PORT=3001
